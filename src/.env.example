# Placeholder template only. Copy to .env on your own computer.
# Never commit real credentials. Replit's existing Secrets are not changed.

# For a separate local/test database: paste the PostgreSQL connection string
# from your own Supabase project. This is NOT the Supabase anon/API key.
# Do not point setup/schema commands at the live hackathon database.
DATABASE_URL=

# Your own OpenAI API key for running outside Replit.
# Do not copy Replit-managed AI integration credentials into GitHub.
AI_API_KEY=
AI_MODEL=gpt-4.1-nano
# Set true to deliberately use Basic mode without making AI requests.
AI_DISABLED=false

# Standalone API process port.
PORT=8080
# Frontend build base path; the frontend needs a different port when run locally.
BASE_PATH=/
